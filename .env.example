# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://opsintel:opsintel@localhost:5432/opsintel

# LLM provider: "mock" (free, deterministic, default) or "groq".
LLM_PROVIDER=mock
GROQ_API_KEY=
# Any Groq chat model that supports tool calling.
LLM_MODEL=llama-3.3-70b-versatile

# Embeddings run locally (Groq has no embeddings API).
# "fastembed" downloads BAAI/bge-small-en-v1.5 (~130 MB) on first use;
# "hashing" is an offline lexical fallback.
EMBEDDER=fastembed

# Signs access tokens (HS256). Use a long random value outside local development:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
